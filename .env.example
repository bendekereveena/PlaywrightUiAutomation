# Environment Configuration for Playwright UI Automation Framework
# Copy this file to .env and update with your values

# Base URLs
BASE_URL=https://www.google.com
GMAIL_URL=https://mail.google.com

# Test Credentials (Use dummy/test accounts only)
GMAIL_USERNAME=testuser.automation
GMAIL_PASSWORD=YourSecurePassword123!

# Recovery Information
RECOVERY_EMAIL=recovery.email@example.com
RECOVERY_PHONE=+1234567890

# Browser Configuration
HEADLESS=true
SLOW_MO=0

# Test Data
EXCEL_PATH=./src/testdata/testData.xlsx

# Reporting
REPORT_DIR=./playwright-report
SCREENSHOT_DIR=./screenshots

# Timeouts (in milliseconds)
SHORT_TIMEOUT=5000
MEDIUM_TIMEOUT=10000
LONG_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=60000
